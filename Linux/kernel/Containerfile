FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bc \
    bison \
    build-essential \
    ca-certificates \
    cpio \
    curl \
    flex \
    git \
    kmod \
    libelf-dev \
    libssl-dev \
    python3 \
    xz-utils \
&&  apt-get clean \
&&  rm -rf /var/lib/apt/lists/*
